// Parameters for the `dev` environment. Values the owner must review are marked
// OWNER. Secrets never go here: the token pepper is generated by
// scripts/deploy-infra.sh on first deploy and lives only in Key Vault.
using 'main.bicep'

param environmentName = 'dev'
param resourceGroupName = 'jolt-dev'

// OWNER: region. Cosmos serverless and Container Apps are both available here.
param location = 'centralindia'

// Image to run. scripts/deploy-infra.sh exports JOLT_IMAGE; unset = infra only
// (no Container Apps environment/app yet).
param containerImage = readEnvironmentVariable('JOLT_IMAGE', '')

// First deploy only: scripts/deploy-infra.sh exports a freshly generated pepper
// when Key Vault has no `token-hash-pepper` yet. Unset = keep the existing secret.
param tokenHashPepper = readEnvironmentVariable('JOLT_TOKEN_HASH_PEPPER', '')

// Browser origins of the app (CORS on /v1 and on Blob for SAS PUTs).
param appOrigins = [
  'http://localhost:5173'
]

// OWNER: the Netlify site and any custom domain, exact origins, no trailing slash.
param netlifyOrigins = [
  'https://jolt-app.netlify.app'
]

// OWNER: deploy previews (https://deploy-preview-<n>--<site>.netlify.app) for the
// API. Blob CORS cannot take a pattern; see docs/DEPLOY.md, "Netlify previews".
param corsOriginRegex = '^https://deploy-preview-[0-9]+--jolt-app\\.netlify\\.app$'

param cosmosDatabaseName = 'jolt'
param blobContainerName = 'sources'

// Scale to zero when idle; one replica max while MCP uses SSE (session affinity).
param minReplicas = 0
param maxReplicas = 1

// Managed Identity only: Cosmos account keys and Storage shared keys are off.
param allowKeyAuth = false

// OWNER (optional): your Entra object id (`az ad signed-in-user show --query id -o tsv`)
// to run the server locally against dev with `az login` + AUTH_MODE=managed_identity.
param developerPrincipalId = ''

// GitHub Actions deploy identity (OIDC federated credential, no secrets).
param githubRepository = 'Dhiwakar1997/jolt-backend'
param githubEnvironment = 'dev'
