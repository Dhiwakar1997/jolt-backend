// Parameters for the `prod` environment (BE-10). Same template as dev, its own
// resource group, stricter settings. Values the owner must review are marked
// OWNER; the example.com values are placeholders (docs/DEPLOY.md, "Production").
// Secrets never go here: the token pepper is generated by
// scripts/deploy-infra.sh on first deploy and lives only in Key Vault.
using 'main.bicep'

param environmentName = 'prod'
param resourceGroupName = 'jolt-prod'

// OWNER: region (same as dev keeps latency and promotion simple).
param location = 'centralindia'

// Image to run: promoted from dev, never built for prod (deploy-prod.yml, or
// scripts/deploy-infra.sh --env prod --promote <tag>). Unset = infra only.
param containerImage = readEnvironmentVariable('JOLT_IMAGE', '')

// First deploy only (generated by scripts/deploy-infra.sh). Unset = keep.
param tokenHashPepper = readEnvironmentVariable('JOLT_TOKEN_HASH_PEPPER', '')

// Browser origins: the production front end only. No localhost, no previews.
// OWNER: the production app origin(s), exact, no trailing slash.
param appOrigins = [
  'https://jolt.example.com'
]
param netlifyOrigins = []
param corsOriginRegex = ''

// OWNER: the API's custom domain (a subdomain). Azure checks DNS when the
// hostname is added, so it needs these records first (docs/DEPLOY.md, "Custom
// domain"; deploy-infra.sh prints both values):
//   CNAME api.jolt.example.com       -> output containerAppFqdn
//   TXT   asuid.api.jolt.example.com -> output customDomainVerificationId
// deploy-infra.sh leaves the domain out (JOLT_SKIP_CUSTOM_DOMAIN=true) while it
// does not resolve, adds it once it does (which issues the managed
// certificate), then binds the certificate (JOLT_CUSTOM_DOMAIN_CERT_READY=true).
var customDomain = 'api.jolt.example.com'
param customDomainName = readEnvironmentVariable('JOLT_SKIP_CUSTOM_DOMAIN', 'false') == 'true' ? '' : customDomain
param customDomainCertificateReady = bool(readEnvironmentVariable('JOLT_CUSTOM_DOMAIN_CERT_READY', 'false'))

// OWNER: the production Google OAuth client id (its Authorized JavaScript
// origins = appOrigins). Not a secret.
param googleOAuthClientId = ''

// Empty = https://<custom domain>/mcp/sse once the certificate is bound.
param mcpServerUrl = ''

// Never in prod: the app refuses to start with it (JOLT_ENV=prod).
param devAuthEnabled = false
param devAuthSecret = ''

// BE-11: feedback and read now on users' own API keys. Empty model = the app
// default (jolt/config.py, .env.example); set one here to move to a newer model
// without a release. Per-user daily caps on model requests and tokens.
param anthropicModel = ''
param openaiModel = ''
param modelDailyRequestCap = 50
param modelDailyTokenCap = 2000000

param cosmosDatabaseName = 'jolt'
param blobContainerName = 'sources'

// One warm replica: no cold start for the first request of the day or for a
// nightly sync. One at most while MCP uses SSE (in-memory sessions), which also
// makes the per-replica rate limits exact.
param minReplicas = 1
param maxReplicas = 1

param allowKeyAuth = false
param developerPrincipalId = ''

// GitHub Actions deploy identity, trusted only for the `prod` environment
// (required reviewers, docs/DEPLOY.md). It may pull from dev's registry to copy
// a tested image (promoteFromEnvironment).
param githubRepository = 'Dhiwakar1997/jolt-backend'
param githubEnvironment = 'prod'
param promoteFromEnvironment = 'dev'

// Backups. Continuous 30-day point-in-time restore for Cosmos (self-service;
// cents at this size). Blob: soft delete and versioning, 14 days.
param cosmosBackupPolicy = 'Continuous30Days'
param blobSoftDeleteDays = 14
param blobVersioning = true
// Fixed when the vault is created: a deleted pepper stays recoverable 90 days.
param keyVaultSoftDeleteDays = 90

// Logs: 90 days, ingestion capped at 5 GB/day.
param logRetentionDays = 90
param logDailyQuotaGb = 5

param maintenanceEnabled = true
param maintenanceSchedule = '17 3 * * *'

// OWNER: who gets alerts and budget mail, and the amounts (billing currency).
param alertEmails = [
  'ops@jolt.example.com'
]
param cosmosRuAlertPerHour = 1000000
param blobCapacityAlertGb = 50
param http5xxAlertCount = 10
param http5xxAlertRatePercent = 5
param budgetAmount = 50
param subscriptionBudgetAmount = 100
param budgetStartDate = '2026-11-01'
