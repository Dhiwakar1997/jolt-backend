# =============================================================================
# Jolt backend — environment configuration
# =============================================================================
# Copy this file to `.env` and fill in the values AFTER you deploy the Azure
# resources. `.env` is git-ignored and must never be committed.
#
# Two credentialing styles are supported per resource:
#   * Managed Identity (preferred, per LLD §9) — leave the *_KEY /
#     *_CONNECTION_STRING blank and set AUTH_MODE=managed_identity. The app
#     authenticates via DefaultAzureCredential (works with a user-assigned or
#     system-assigned identity in Container Apps, and `az login` locally).
#   * Key / connection string — for local dev or the Cosmos emulator. Set
#     AUTH_MODE=key and provide the *_KEY / *_CONNECTION_STRING values below.
# =============================================================================

# ---- General -----------------------------------------------------------------
# dev | prod  — used for logging / resource-group conventions only.
JOLT_ENV=dev
# How the app authenticates to Azure data services: managed_identity | key
AUTH_MODE=key
# Comma-separated CORS origins for the Flutter app (use * only in dev).
CORS_ORIGINS=*

# ---- Auth (opaque user tokens) ----------------------------------------------
# Prefix for issued tokens, e.g. jolt_live_<random>. Keep stable across a deploy.
TOKEN_PREFIX=jolt_live_
# Extra server-side pepper mixed into token hashing. Generate a long random
# string; store it in Key Vault in prod and inject as an env ref.
TOKEN_HASH_PEPPER=change-me-to-a-long-random-string

# ---- Cosmos DB (serverless, NoSQL API) --------------------------------------
# Account endpoint, e.g. https://jolt-dev.documents.azure.com:443/
COSMOS_ENDPOINT=
# Database name (created on startup if missing).
COSMOS_DATABASE=jolt
# Only needed when AUTH_MODE=key (account key or emulator key).
COSMOS_KEY=

# ---- Blob Storage (Hot tier) ------------------------------------------------
# Account URL, e.g. https://joltdev.blob.core.windows.net
BLOB_ACCOUNT_URL=
# Container for uploaded source files.
BLOB_CONTAINER=sources
# Only needed when AUTH_MODE=key. A full connection string OR an account key.
BLOB_CONNECTION_STRING=
BLOB_ACCOUNT_KEY=
# TTL (seconds) for the upload/read SAS URLs Jolt hands out.
BLOB_SAS_TTL_SECONDS=900

# ---- Key Vault (tokens signing material + per-user provider keys) -----------
# Vault URL, e.g. https://jolt-dev-kv.vault.azure.net/
KEYVAULT_URL=

# ---- Leases ------------------------------------------------------------------
# Seconds a source/grading row stays leased (in_flight) before it is reclaimable.
LEASE_TTL_SECONDS=900

# ---- FSRS --------------------------------------------------------------------
# Target retention for the FSRS scheduler (0.70–0.97). 0.9 is the library default.
FSRS_DESIRED_RETENTION=0.9

# ---- Key-backed provider calls (dormant in MVP — capture + storage only) -----
# Nothing to fill in for MVP. Provider base URLs can be overridden if needed.
ANTHROPIC_API_BASE=https://api.anthropic.com
OPENAI_API_BASE=https://api.openai.com
