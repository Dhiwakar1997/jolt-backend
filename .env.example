# =============================================================================
# Jolt backend: environment configuration
# =============================================================================
# Every setting the app reads (jolt/config.py), with its default. Copy to `.env`
# for local runs; `.env` is git-ignored and must never be committed.
#
# In Azure (Container Apps) these are NOT read from a file: infra/ (Bicep) sets
# them on the jolt-api container, and TOKEN_HASH_PEPPER is a Key Vault secret
# reference. docs/DEPLOY.md lists who sets what.
#
# Three ways to run:
#   1. No cloud at all:  STORAGE_MODE=memory (+ PUBLIC_BASE_URL so uploads work,
#      + DEV_AUTH_ENABLED=true to sign in without Google).
#   2. Against Azure with Entra ID (preferred): AUTH_MODE=managed_identity. In
#      Container Apps the user-assigned identity is used (AZURE_CLIENT_ID); locally
#      DefaultAzureCredential uses `az login` (needs `developerPrincipalId` in
#      infra/main.dev.bicepparam so your user has data access).
#   3. Against an emulator / key-enabled account: AUTH_MODE=key + the *_KEY values.
#      The dev environment disables keys (allowKeyAuth=false), so this is for
#      the Cosmos emulator / Azurite only.
# =============================================================================

# ---- General -----------------------------------------------------------------
# dev | prod. Set by Bicep from the environment name.
JOLT_ENV=dev
# How the app authenticates to Cosmos/Blob: managed_identity | key.
# Azure: managed_identity (set by Bicep). Key Vault always uses Entra ID.
AUTH_MODE=key
# Where state lives: azure | memory. `memory` = in-process fakes for Cosmos, Blob
# and Key Vault (no cloud; everything is lost on restart). Never in Azure.
STORAGE_MODE=azure
# Build identifier reported by GET /health. The Docker image sets it from the
# APP_VERSION build arg (the git SHA in CI); leave unset locally.
APP_VERSION=dev

# ---- CORS (browser app) ------------------------------------------------------
# Comma-separated exact origins allowed to call the API from a browser, or `*`.
# Azure: Bicep sets appOrigins + netlifyOrigins from infra/main.dev.bicepparam.
CORS_ORIGINS=http://localhost:5173
# Optional regex for origins that cannot be listed, e.g. Netlify deploy previews:
# ^https://deploy-preview-[0-9]+--jolt-app\.netlify\.app$
CORS_ORIGIN_REGEX=

# ---- Memory mode only --------------------------------------------------------
# Base URL of this server. With STORAGE_MODE=memory, upload/read URLs then point
# at /_dev/blob/... on this server so a browser or scripts/smoke.py can really
# PUT the file. Empty = opaque memory:// URLs (tests). Ignored in azure mode.
PUBLIC_BASE_URL=
# A Jolt checkout to import the curated DSA track from at startup (BE-09; the
# same import as scripts/import_dsa.py), e.g. ../Jolt. Empty = no curated tracks.
# DSA_SEED_INCLUDE_NEW=true also takes data/new/ (only problems marked original).
DSA_SEED_FROM=
DSA_SEED_INCLUDE_NEW=false

# ---- Auth (sign-in and opaque tokens, BE-03) ---------------------------------
# Two token kinds: app tokens (one per signed-in device, accepted on /v1) and
# MCP tokens (one per connected Claude / Codex client, accepted on /mcp).
# Prefixes of issued tokens. Keep them stable once tokens exist.
APP_TOKEN_PREFIX=jolt_app_
MCP_TOKEN_PREFIX=jolt_live_
# Server-side pepper mixed into token hashing (Argon2) and keying the token
# lookup index (HMAC). Changing it invalidates every issued token. Azure: Key
# Vault secret `token-hash-pepper`, generated once by scripts/deploy-infra.sh.
# Locally: any long random string. With STORAGE_MODE=azure the API refuses to
# start with this placeholder or anything under 32 characters.
TOKEN_HASH_PEPPER=change-me-to-a-long-random-string
# Google sign-in: the OAuth 2.0 client id(s) (type "Web application") whose ID
# tokens POST /v1/auth/google accepts, comma-separated, e.g.
# 1234567890-abc.apps.googleusercontent.com. Not a secret. Empty = Google
# sign-in answers 503. Azure: Bicep param googleOAuthClientId.
GOOGLE_OAUTH_CLIENT_ID=
# The MCP address GET /v1/me shows the app ("Connect your model"), e.g.
# https://<api-host>/mcp/sse. Empty = <PUBLIC_BASE_URL>/mcp/sse, else derived
# from the request. Azure: set by Bicep from the app's FQDN (or mcpServerUrl).
MCP_SERVER_URL=
# Dev-only sign-in without Google: POST /v1/auth/dev {email, display_name?}.
# Refused when JOLT_ENV=prod. With STORAGE_MODE=azure it also needs
# DEV_AUTH_SECRET, which callers send as the X-Jolt-Dev-Auth-Secret header.
# Local memory mode: DEV_AUTH_ENABLED=true is enough (secret optional).
# Azure dev: Bicep param devAuthEnabled + Key Vault secret `dev-auth-secret`.
DEV_AUTH_ENABLED=false
DEV_AUTH_SECRET=
# An app token (a signed-in device) stops working after this many days without
# a request (401 "token expired; sign in again"); every request renews it, and
# the maintenance job deletes expired ones. 0 = never expire. MCP tokens never
# expire; users revoke them in Settings (docs/SECURITY.md).
APP_TOKEN_IDLE_DAYS=30

# ---- Cosmos DB (serverless, NoSQL API) ---------------------------------------
# Account endpoint, e.g. https://cosmos-jolt-dev-xxxx.documents.azure.com:443/
# Azure: set by Bicep (output cosmosEndpoint).
COSMOS_ENDPOINT=
# Database name. Azure: the database and containers are created by Bicep (the
# app cannot create them under Managed Identity). With AUTH_MODE=key they are
# created on startup if missing.
COSMOS_DATABASE=jolt
# Only with AUTH_MODE=key (emulator key).
COSMOS_KEY=

# ---- Blob Storage ------------------------------------------------------------
# Account URL, e.g. https://stjoltdevxxxx.blob.core.windows.net/
# Azure: set by Bicep (output blobAccountUrl).
BLOB_ACCOUNT_URL=
# Private container for uploaded sources (created by Bicep).
BLOB_CONTAINER=sources
# Only with AUTH_MODE=key: a full connection string (e.g. Azurite) OR an account key.
BLOB_CONNECTION_STRING=
BLOB_ACCOUNT_KEY=
# Lifetime (seconds) of the upload/read SAS URLs Jolt hands out.
BLOB_SAS_TTL_SECONDS=900

# ---- Uploads and sources (BE-05) ---------------------------------------------
# Per-file limit in bytes (25 MiB), files per multi-page upload, the confidence
# under which a read is flagged "low confidence", and how many lapsed sync leases
# a source gets before it is marked failed.
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_PAGES=30
LOW_CONFIDENCE_THRESHOLD=0.6
SOURCE_MAX_ATTEMPTS=3

# ---- Data export (BE-08) -----------------------------------------------------
# Lifetime (seconds) of the signed download URL from POST /v1/export. Export
# files live under `exports/` in BLOB_CONTAINER; the next export, account delete
# and a Blob lifecycle rule (1 day, infra/modules/storage.bicep) remove them.
EXPORT_URL_TTL_SECONDS=3600

# ---- Observability (BE-10) ---------------------------------------------------
# Application Insights connection string. Empty = telemetry off (no exporter is
# loaded; tests and local runs). Azure: Bicep sets it from the workspace-based
# Application Insights resource (a Container Apps secret). See jolt/telemetry.py
# for the custom metrics.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- Rate and size limits (BE-10) --------------------------------------------
# In-process token buckets, so they hold per replica. Each bucket holds one
# minute's worth and refills continuously; over it -> 429 + Retry-After.
RATE_LIMIT_ENABLED=true
# Requests per minute per app token on /v1 (no token: per client IP).
RATE_LIMIT_REST_PER_MINUTE=120
# MCP tool calls (and connections opened) per minute per MCP token.
RATE_LIMIT_MCP_PER_MINUTE=300
# Coarse cap per client IP over /v1 and /mcp together.
RATE_LIMIT_IP_PER_MINUTE=600
# Proxies in front of the app that append the caller's address to
# X-Forwarded-For; the per-IP limit uses the entry this many from the right, so
# a client cannot choose its own bucket. 0 = the TCP peer (local runs).
# Azure: 1 (the Container Apps ingress), set by Bicep.
TRUSTED_PROXY_HOPS=0
# Largest request body in bytes on /v1 (1 MiB) and /mcp (4 MiB); over -> 413.
# Files never pass through the API (they go straight to Blob).
REQUEST_MAX_BYTES=1048576
MCP_REQUEST_MAX_BYTES=4194304

# ---- API docs (BE-10) ---------------------------------------------------------
# /docs, /redoc and the live /openapi.json. Unset = on, except with
# JOLT_ENV=prod (the contract is in contract/openapi.json).
# API_DOCS_ENABLED=true

# ---- Maintenance (BE-10) -----------------------------------------------------
# `python -m jolt.maintenance` (a daily Container Apps Job in Azure) deletes
# uploads never confirmed after this many hours, and sources older than each
# user's data_retention_days.
ABANDONED_UPLOAD_HOURS=24

# ---- Key Vault (per-user provider API keys) ----------------------------------
# Vault URL, e.g. https://kv-jolt-dev-xxxxxxxx.vault.azure.net/
# Azure: set by Bicep (output keyVaultUri).
KEYVAULT_URL=

# ---- Leases ------------------------------------------------------------------
# Seconds a claimed source/grading stays in_flight before it can be reclaimed.
LEASE_TTL_SECONDS=900

# ---- Nightly sync (BE-04) ---------------------------------------------------
# A running sync with no tool call for this many seconds is closed as incomplete.
SYNC_RUN_IDLE_SECONDS=1800
# GET /v1/sync/status says `late` when the last run started longer ago than this.
SYNC_LATE_AFTER_HOURS=30
# Recommended local time for the user's scheduled task (decision D5).
SYNC_SCHEDULE_TIME=00:15
# Accept the MCP token as ?token= on GET /mcp/sse (Claude custom connectors take
# only a URL). Redacted from access logs. false = Authorization header only.
MCP_QUERY_TOKEN_ENABLED=true

# ---- FSRS --------------------------------------------------------------------
# Default FSRS desired retention (0.70-0.97) for users who have not picked one;
# each user can set their own (0.80-0.97) with PATCH /v1/settings (BE-08).
FSRS_DESIRED_RETENTION=0.9
# A concept is "mastered" once its FSRS stability (days) reaches this after a
# Good or Easy answer; users with "retire mastered" on stop seeing it.
MASTERY_STABILITY_DAYS=21

# ---- Supersede reconciliation (BE-07) ----------------------------------------
# Concepts one call reconciles when a re-read supersedes an old one; a larger
# supersede is checkpointed and the agent resumes it with
# jolt_continue_reconciliation (see docs/API.md).
RECONCILE_MAX_CONCEPTS=25

# ---- Key-backed model calls (BE-11) -------------------------------------------
# Feedback (POST /v1/concepts/{id}/feedback) and read now (POST
# /v1/sources/{id}/read-now) call the model on the user's OWN key (stored in Key
# Vault, POST /v1/settings/api-key); without a key they answer 403 key_required
# and make no outbound call. Never a Jolt-owned key: there is none.
# Provider base URLs. Point them at a fake provider for tests and local runs:
#   python scripts/fake_provider.py --port 8043
#   ANTHROPIC_API_BASE=http://127.0.0.1:8043 OPENAI_API_BASE=http://127.0.0.1:8043
# (key validation at capture uses the same base URLs).
ANTHROPIC_API_BASE=https://api.anthropic.com
OPENAI_API_BASE=https://api.openai.com
# The model each provider is asked for: Anthropic Messages API, OpenAI Responses
# API. Change here (Azure: Bicep params anthropicModel / openaiModel) when a
# newer model is out; the read's model_id records what actually answered.
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-5.1
# Send a reasoning-effort hint (low for feedback, medium for reading): Anthropic
# output_config.effort, OpenAI reasoning.effort. false for a model that rejects it.
ANTHROPIC_SEND_EFFORT=true
OPENAI_SEND_REASONING=true
# Anthropic server-side refusal fallback (fallbacks: "default"): a declined
# request is re-run on a fallback model in the same call. false to turn off.
ANTHROPIC_REFUSAL_FALLBACK=true
# Per-user spend guard, per UTC day: model requests and input+output tokens.
# Over either: 429 spend_limit with Retry-After (next midnight UTC). 0 = the
# key-backed features are off.
MODEL_DAILY_REQUEST_CAP=50
MODEL_DAILY_TOKEN_CAP=2000000
# Timeouts (seconds) of the synchronous calls (under the 240 s ingress timeout)
# and output ceilings (tokens, reasoning included).
MODEL_FEEDBACK_TIMEOUT_SECONDS=45
MODEL_READ_TIMEOUT_SECONDS=150
MODEL_FEEDBACK_MAX_TOKENS=4000
MODEL_READ_MAX_TOKENS=16000
# Read now sends the original pages: JPEG / PNG / WebP up to this many bytes
# each (providers cap an image near 5 MB once base64-encoded), PDFs as
# documents, at most READ_NOW_MAX_TOTAL_BYTES per note. Larger notes and HEIC
# pages answer 413 / 415 and wait for the nightly sync.
READ_NOW_MAX_IMAGE_BYTES=3750000
READ_NOW_MAX_TOTAL_BYTES=20971520

# ---- Azure SDK (not a Jolt setting) ------------------------------------------
# Client id of the user-assigned Managed Identity DefaultAzureCredential should
# use. Azure: set by Bicep. Locally: leave unset (az login is used).
# AZURE_CLIENT_ID=
