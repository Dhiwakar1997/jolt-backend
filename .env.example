# =============================================================================
# Jolt backend: environment configuration
# =============================================================================
# Every setting the app reads (jolt/config.py), with its default. Copy to `.env`
# for local runs; `.env` is git-ignored and must never be committed.
#
# In Azure (Container Apps) these are NOT read from a file: infra/ (Bicep) sets
# them on the jolt-api container, and TOKEN_HASH_PEPPER is a Key Vault secret
# reference. docs/DEPLOY.md lists who sets what.
#
# Three ways to run:
#   1. No cloud at all:  STORAGE_MODE=memory (+ PUBLIC_BASE_URL so uploads work).
#   2. Against Azure with Entra ID (preferred): AUTH_MODE=managed_identity. In
#      Container Apps the user-assigned identity is used (AZURE_CLIENT_ID); locally
#      DefaultAzureCredential uses `az login` (needs `developerPrincipalId` in
#      infra/main.dev.bicepparam so your user has data access).
#   3. Against an emulator / key-enabled account: AUTH_MODE=key + the *_KEY values.
#      The dev environment disables keys (allowKeyAuth=false), so this is for
#      the Cosmos emulator / Azurite only.
# =============================================================================

# ---- General -----------------------------------------------------------------
# dev | prod. Set by Bicep from the environment name.
JOLT_ENV=dev
# How the app authenticates to Cosmos/Blob: managed_identity | key.
# Azure: managed_identity (set by Bicep). Key Vault always uses Entra ID.
AUTH_MODE=key
# Where state lives: azure | memory. `memory` = in-process fakes for Cosmos, Blob
# and Key Vault (no cloud; everything is lost on restart). Never in Azure.
STORAGE_MODE=azure
# Build identifier reported by GET /health. The Docker image sets it from the
# APP_VERSION build arg (the git SHA in CI); leave unset locally.
APP_VERSION=dev

# ---- CORS (browser app) ------------------------------------------------------
# Comma-separated exact origins allowed to call the API from a browser, or `*`.
# Azure: Bicep sets appOrigins + netlifyOrigins from infra/main.dev.bicepparam.
CORS_ORIGINS=http://localhost:5173
# Optional regex for origins that cannot be listed, e.g. Netlify deploy previews:
# ^https://deploy-preview-[0-9]+--jolt-app\.netlify\.app$
CORS_ORIGIN_REGEX=

# ---- Memory mode only --------------------------------------------------------
# Base URL of this server. With STORAGE_MODE=memory, upload/read URLs then point
# at /_dev/blob/... on this server so a browser or scripts/smoke.py can really
# PUT the file. Empty = opaque memory:// URLs (tests). Ignored in azure mode.
PUBLIC_BASE_URL=

# ---- Auth (opaque user tokens) -----------------------------------------------
# Prefix for issued tokens (jolt_live_<random>). Keep stable once users exist.
TOKEN_PREFIX=jolt_live_
# Server-side pepper mixed into token hashing. Changing it invalidates every
# issued token. Azure: Key Vault secret `token-hash-pepper`, generated once by
# scripts/deploy-infra.sh. Locally: any long random string.
TOKEN_HASH_PEPPER=change-me-to-a-long-random-string

# ---- Cosmos DB (serverless, NoSQL API) ---------------------------------------
# Account endpoint, e.g. https://cosmos-jolt-dev-xxxx.documents.azure.com:443/
# Azure: set by Bicep (output cosmosEndpoint).
COSMOS_ENDPOINT=
# Database name. Azure: the database and containers are created by Bicep (the
# app cannot create them under Managed Identity). With AUTH_MODE=key they are
# created on startup if missing.
COSMOS_DATABASE=jolt
# Only with AUTH_MODE=key (emulator key).
COSMOS_KEY=

# ---- Blob Storage ------------------------------------------------------------
# Account URL, e.g. https://stjoltdevxxxx.blob.core.windows.net/
# Azure: set by Bicep (output blobAccountUrl).
BLOB_ACCOUNT_URL=
# Private container for uploaded sources (created by Bicep).
BLOB_CONTAINER=sources
# Only with AUTH_MODE=key: a full connection string (e.g. Azurite) OR an account key.
BLOB_CONNECTION_STRING=
BLOB_ACCOUNT_KEY=
# Lifetime (seconds) of the upload/read SAS URLs Jolt hands out.
BLOB_SAS_TTL_SECONDS=900

# ---- Key Vault (per-user provider API keys) ----------------------------------
# Vault URL, e.g. https://kv-jolt-dev-xxxxxxxx.vault.azure.net/
# Azure: set by Bicep (output keyVaultUri).
KEYVAULT_URL=

# ---- Leases ------------------------------------------------------------------
# Seconds a claimed source/grading stays in_flight before it can be reclaimed.
LEASE_TTL_SECONDS=900

# ---- FSRS --------------------------------------------------------------------
# Target retention for the FSRS scheduler (0.70-0.97).
FSRS_DESIRED_RETENTION=0.9

# ---- Key-backed provider calls (dormant in MVP: capture + storage only) ------
ANTHROPIC_API_BASE=https://api.anthropic.com
OPENAI_API_BASE=https://api.openai.com

# ---- Azure SDK (not a Jolt setting) ------------------------------------------
# Client id of the user-assigned Managed Identity DefaultAzureCredential should
# use. Azure: set by Bicep. Locally: leave unset (az login is used).
# AZURE_CLIENT_ID=
